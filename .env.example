# ==============================================================================
# ANDEMTA MONOREPO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file or individual app .env.example files to configure your environment.
# Note: For apps/api, configure apps/api/.env
#       For apps/web, configure apps/web/.env.local
# ==============================================================================

# Node Environment
NODE_ENV=development

# Backend API Service (apps/api)
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Local Windows installation)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/andemta_db?schema=public"

# Redis Cache & Background Jobs (Local WSL2 Ubuntu installation)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend Web Application (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Email / Brevo SMTP Configuration (Phase 3.3)
EMAIL_PROVIDER=nodemailer
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=YOUR_BREVO_SMTP_LOGIN
EMAIL_PASSWORD=YOUR_BREVO_SMTP_KEY
EMAIL_FROM="Andemta <your-verified-sender@gmail.com>"
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
FRONTEND_EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email

# JWT Access Token Configuration (Phase 3.4)
JWT_ACCESS_SECRET=your-minimum-32-character-random-access-secret-key-goes-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=andemta-api
JWT_AUDIENCE=andemta-client

