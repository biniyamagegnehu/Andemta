# ==============================================================================
# ANDEMTA MONOREPO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file or individual app .env.example files to configure your environment.
# Note: For apps/api, configure apps/api/.env
#       For apps/web, configure apps/web/.env.local
# ==============================================================================

# Node Environment
NODE_ENV=development

# Backend API Service (apps/api)
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Local Windows installation)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/andemta_db?schema=public"

# Redis Cache & Background Jobs (Local WSL2 Ubuntu installation)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend Web Application (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

