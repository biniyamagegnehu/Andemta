{
  "name": "andemta",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared",
    "packages/config"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev --workspace=@andemta/api",
    "dev:web": "npm run dev --workspace=@andemta/web",
    "build": "npm run build --workspace=@andemta/api && npm run build --workspace=@andemta/web",
    "lint": "npm run lint --workspace=@andemta/api && npm run lint --workspace=@andemta/web",
    "test:api": "npm run test --workspace=@andemta/api",
    "test:api:e2e": "npm run test:e2e --workspace=@andemta/api",
    "prisma:generate": "npm run prisma:generate --workspace=@andemta/api",
    "prisma:validate": "npm run prisma:validate --workspace=@andemta/api",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace=@andemta/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=@andemta/api",
    "prisma:studio": "npm run prisma:studio --workspace=@andemta/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "lodash": "^4.18.1"
  }
}
