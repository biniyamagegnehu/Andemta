NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection
# Query timeout in ms to prevent connection pool exhaustion (Phase 3.9 H-02)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/andemta_db?schema=public"
DATABASE_QUERY_TIMEOUT_MS=30000

# Redis Infrastructure (Phase 3.9 J-02)
# REDIS_PASSWORD is required in production environments.
# REDIS_TLS_ENABLED must be set to true when using encrypted in-transit Redis (e.g. AWS ElastiCache, Upstash).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# Reverse Proxy / Ingress IP Resolution (Phase 3.9 F-04)
# In production behind AWS ALB, Cloudflare, NGINX, or Traefik, set to true, 'loopback', or trusted subnet CIDR.
TRUST_PROXY=false

# Frontend Application Origin (Phase 3.9 F-01, F-02)
FRONTEND_URL=http://localhost:3000

# Rate Limiting & Throttler Configuration (Phase 3.9 G-01, D-02)
# RATE_LIMIT_ENABLED defaults to true.
# RATE_LIMIT_FAIL_CLOSED=false fails open to in-memory fallback on Redis outage; set to true in ultra-strict environments.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=false

# Swagger OpenAPI Documentation (Phase 3.9 J-01)
# Default is false in production to prevent schema enumeration. Enable explicitly for dev/staging.
SWAGGER_ENABLED=false

# Email / Brevo SMTP Configuration (Phase 3.3)
EMAIL_PROVIDER=nodemailer
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=YOUR_BREVO_SMTP_LOGIN
EMAIL_PASSWORD=YOUR_BREVO_SMTP_KEY
EMAIL_FROM="Andemta <your-verified-sender@gmail.com>"
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
FRONTEND_EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email

# JWT Access Token Configuration (Phase 3.4, Phase 3.9 B-01)
# Generate a cryptographically secure random secret in terminal: `openssl rand -base64 32`
JWT_ACCESS_SECRET=your-minimum-32-character-random-access-secret-key-goes-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=andemta-api
JWT_AUDIENCE=andemta-client

# Refresh Token and Session Cookie Configuration (Phase 3.5, Phase 3.9 C-02)
# In production, AUTH_COOKIE_SECURE must be true (requires HTTPS).
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=andemta_refresh
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_CLEANUP_RETENTION_DAYS=30

# Password Recovery Configuration (Phase 3.7)
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Google OAuth 2.0 Configuration (Phase 3.8, Phase 3.9 E-02)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
FRONTEND_GOOGLE_AUTH_SUCCESS_URL=http://localhost:3000/auth/google/callback
FRONTEND_GOOGLE_AUTH_FAILURE_URL=http://localhost:3000/login
GOOGLE_OAUTH_STATE_TTL_SECONDS=300
