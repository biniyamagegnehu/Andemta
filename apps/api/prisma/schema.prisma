// Prisma schema configuration for Andemta backend
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// AUTHENTICATION MODELS (Phase 3.1)
// ==============================================================================

/// Represents an Andemta user account.
model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  passwordHash      String?   @map("password_hash")
  tokenVersion      Int       @default(0) @map("token_version")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  fullName          String?   @map("full_name")
  phoneNumber       String?   @map("phone_number")
  preferredLanguage String    @default("en") @map("preferred_language")
  bio               String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Authentication relationships
  sessions                Session[]
  externalAccounts        ExternalAccount[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  // RBAC relationships (Phase 4.1)
  systemRoles             UserSystemRole[]
  organizationMemberships OrganizationMembership[]

  @@map("users")
}

/// Represents an authenticated user session for refresh-token management.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  tokenFamily      String    @map("token_family")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  rotatedAt        DateTime? @map("rotated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime? @map("last_used_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")

  // Foreign key relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Performance and query indexes
  @@index([userId])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([rotatedAt])
  @@map("sessions")
}

/// Represents a federated external identity (e.g. Google OAuth) linked to a user.
model ExternalAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  providerEmail     String?  @map("provider_email")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Foreign key relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite unique constraint: provider + providerAccountId must be globally unique
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("external_accounts")
}

/// Represents a single-use token for email address verification.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Foreign key relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Represents a single-use token for password reset flows.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Foreign key relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ==============================================================================
// RBAC & AUTHORIZATION MODELS (Phase 4.1)
// ==============================================================================

/// Authorization scope: global system-level vs organization-level.
enum RoleScope {
  SYSTEM
  ORGANIZATION
}

/// Organization classifications.
enum OrganizationType {
  BUSINESS
  UNIVERSITY
  OTHER
}

/// Operational status for organizations.
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// Operational status for organization memberships.
enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  INACTIVE
}

/// Represents an authorization role with a specific scope (SYSTEM or ORGANIZATION).
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  scope       RoleScope
  code        String
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  isBuiltIn   Boolean   @default(true) @map("is_built_in")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  rolePermissions         RolePermission[]
  userSystemRoles         UserSystemRole[]
  organizationMemberships OrganizationMembership[]

  @@unique([scope, code])
  @@unique([id, scope])
  @@index([scope])
  @@index([isActive])
  @@map("roles")
}

/// Represents an atomic resource-action authorization permission.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([isActive])
  @@map("permissions")
}

/// Maps permissions granted to a role.
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Connects a user to a platform system-level role (e.g. PARTICIPANT, ADMIN).
model UserSystemRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  roleScope RoleScope @default(SYSTEM) @map("role_scope")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId, roleScope], references: [id, scope], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_system_roles")
}

/// Represents an organization (e.g. Business, University) in Andemta.
model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  type      OrganizationType   @default(OTHER)
  status    OrganizationStatus @default(ACTIVE)
  settings  Json?              @db.JsonB
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  memberships OrganizationMembership[]

  @@index([status])
  @@index([type])
  @@map("organizations")
}

/// Connects a user to an organization with an organization-scoped role.
model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  roleScope      RoleScope        @default(ORGANIZATION) @map("role_scope")
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId, roleScope], references: [id, scope], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@index([status])
  @@map("organization_memberships")
}
